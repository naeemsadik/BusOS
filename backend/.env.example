# Application
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000

# Allowed frontend origins and redirect targets
FRONTEND_1_URL=http://localhost:3000
FRONTEND_2_URL=http://localhost:3001
FRONTEND_3_URL=http://localhost:3002
FRONTEND_4_URL=http://localhost:3003
# Legacy fallback used by email links when FRONTEND_1_URL is not set
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=pos
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
TYPEORM_SYNCHRONIZE=false

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Default admin seed (used by scripts/create-admin.js)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@inventory-pos.com
ADMIN_PASSWORD=admin123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# AI features (server-side only)
# Never expose this key through a NEXT_PUBLIC_* variable or commit it to source control.
AI_API_KEY=replace-with-ai-api-key

# SMTP email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_SECURE=false
FROM_NAME=BizOS
FROM_EMAIL=noreply@example.com

# BulkSMS BD
SMS_BASE_URL=https://bulksmsbd.net/api
SMS_API_KEY=replace-with-sms-api-key
SMS_SENDER_ID=replace-with-sender-id

# bKash tokenized checkout
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=replace-with-bkash-app-key
BKASH_APP_SECRET=replace-with-bkash-app-secret
BKASH_USERNAME=replace-with-bkash-username
BKASH_PASSWORD=replace-with-bkash-password
BKASH_CALLBACK_URL=http://localhost:3000/payments/bkash/callback

# SSLCommerz
SSLCOMMERZ_STORE_ID=replace-with-store-id
SSLCOMMERZ_STORE_PASSWORD=replace-with-store-password
SSLCOMMERZ_IS_LIVE=false
