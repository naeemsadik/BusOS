# Application endpoints
BUSOS_E2E_BASE_URL=http://127.0.0.1:3000
BUSOS_E2E_ADMIN_URL=http://127.0.0.1:3001

# Seeded organization owner
BUSOS_E2E_OWNER_EMAIL=
BUSOS_E2E_OWNER_PASSWORD=

# Seeded staff member linked to an HRM employee
BUSOS_E2E_STAFF_EMAIL=
BUSOS_E2E_STAFF_PASSWORD=

# Seeded platform administrator
BUSOS_E2E_ADMIN_USERNAME=
BUSOS_E2E_ADMIN_PASSWORD=
BUSOS_E2E_ORGANIZATION_QUERY=a

# Published storefront slug
BUSOS_E2E_STOREFRONT_SLUG=
# Optional canonical storefront origin, for example http://demo.localhost:3000
BUSOS_E2E_STOREFRONT_URL=

# Browser execution
BUSOS_E2E_BROWSER=chrome
BUSOS_E2E_HEADLESS=true
BUSOS_E2E_TIMEOUT=15
BUSOS_E2E_WINDOW=1440x900
SELENIUM_REMOTE_URL=

# Write operations are disabled unless this is explicitly true.
BUSOS_E2E_MUTATIONS=false

